# ==========================================
# EmailJS Configuration for RSVP Form
# ==========================================
# Obtain these credentials from your EmailJS Dashboard: https://dashboard.emailjs.com/

# 1. EmailJS Service ID (from "Email Services" tab, e.g. service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# 2. EmailJS Template ID (from "Email Templates" tab, e.g. template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# 3. EmailJS Public Key (from "Account" -> "API Keys" -> "Public Key", e.g. user_xxxxxxx or XxXxXxXxXxXx)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
